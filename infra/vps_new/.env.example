# Nemo VPS — имена переменных окружения (реальные значения — в .env, не коммитить)
# Базовый .env.example для infra/vps_new compose

# --- PocketBase ---
PB_ENCRYPTION_KEY=          # 32-байтовый ключ шифрования PocketBase
PB_SMTP_HOST=               # SMTP-хост для отправки писем
PB_SMTP_PORT=               # SMTP-порт
PB_SMTP_USER=               # SMTP-пользователь
PB_SMTP_PASS=               # SMTP-пароль
PB_SMTP_TLS=true            # Использовать TLS для SMTP

# --- Push & LiveKit gateway ---
PUSH_GATEWAY_SECRET=        # S2S-секрет gateway↔PocketBase. VPS: здесь (infra/vps_new/.env, env_file);
                            # домашняя PocketBase (dev/prod): то же значение в app/.env (env_file)
VAPID_PUBLIC_KEY=           # Публичный ключ VAPID (Web Push)
VAPID_PRIVATE_KEY=          # Приватный ключ VAPID (Web Push)
LIVEKIT_API_KEY=            # LiveKit API key
LIVEKIT_API_SECRET=         # LiveKit API secret

# --- FRP tunnel ---
FRP_TOKEN=                  # Токен аутентификации FRP-туннеля

# --- Опциональные rate limits (defaults: 120 push/min, 60 token/min) ---
# RATE_LIMIT_SEND_PUSH_PER_MIN=120
# RATE_LIMIT_LIVEKIT_TOKEN_PER_MIN=60
